# Server
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins (the Next.js app)
CORS_ORIGINS=http://localhost:3000

# Reverse proxies in front of the API, used to find the client IP for rate limiting.
# 1 = one proxy (e.g. Railway); 2 = Vercel rewrite + Railway.
TRUST_PROXY_HOPS=1

# Database
MONGO_URI=mongodb://localhost:27017/lms

# Auth
# Works for local runs as-is. In production set your own long random string (the server refuses this one).
JWT_SECRET=local-dev-only-secret-do-not-use-in-production
JWT_EXPIRES_IN=1d
# Create the demo accounts on first start if the database is empty (default: true outside production)
SEED_ON_START=true

# Salary-slip storage: "local" (backend/uploads) or "s3"
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
# Required only when STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=ap-south-1
# Keys for an IAM user that can only read/write this bucket. Leave both empty to use the default AWS
# credential chain (AWS_* env vars, ~/.aws profile, or an instance role). S3_* names are used because
# some hosts (e.g. Vercel) reserve the AWS_* variable names.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
